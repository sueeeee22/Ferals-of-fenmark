# Copy to .env.local and fill in from the Firebase console
# (Project settings > Your apps > SDK setup and configuration).
#
# None of these are secrets. Vite inlines every VITE_-prefixed variable into
# the client bundle, so treat them as public. Firestore access is enforced by
# firestore.rules, not by keeping these hidden.
#
# Never add a service account key or a firebase login:ci token here — those are
# real credentials and must not be VITE_-prefixed or committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to route `npm run dev` at the local Firestore emulator
# (`npx firebase-tools emulators:start`) instead of the real database.
VITE_FIRESTORE_EMULATOR=false
